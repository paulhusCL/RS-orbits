/* orbits.mag

Compute braid and topological equivalence classes of group actions on
Riemann surfaces, starting from the generating vectors produced by
RepresentativesEpimorphisms in genvectors.mag
(https://github.com/jenpaulhus/breuer-modified).

Only quotient genus 0 is supported: for g0 > 0, RepresentativesEpimorphisms
does not return a complete list of vectors up to simultaneous conjugation,
so the orbits would not be meaningful.

Equivalences (signature [0, m_1, ..., m_r] with m_1 <= ... <= m_r):
  braid        orbits of the braid group elements that preserve the
               signature (cone points of equal order may be permuted)
  topological  orbits of Aut(G) x (braid group above)

Functions:
  FindOrbits(data)                   braid and topological class of each vector
  OrbitsFromIds(ids)                 class ids -> list of orbits
  PrintOrbits(data, brd, top)        print / write the result
  ReadGenvectorFile(filename)        read a file written by AddMonodromy
  OrbitsFromFile(infile, outfile)    FindOrbits on every family in a file

Typical use:
  load "genvectors.mag";
  load "orbits.mag";
  data := RepresentativesEpimorphisms([0,2,3,7], PSL(2,7));
  brd, top := FindOrbits(data);
  PrintOrbits(data, brd, top);

*/


ReFo := recformat< signature, Con, Gro, genimages >;   // same as genvectors.mag



/* ***************************************
Hurwitz moves on a generating vector v = [c_1, ..., c_r] with c_1*...*c_r = 1.

  sigma_i    : (.., a, b, ..) -> (.., a*b*a^-1, a, ..)
  sigma_i^-1 : (.., a, b, ..) -> (.., b, b^-1*a*b, ..)

A braid word is a sequence of nonzero integers: i means sigma_i and
-i means sigma_i^-1, applied left to right.
************************************ */

ApplyBraidWord := function(v, word)
   for s in word do
      i := Abs(s);
      a := v[i];
      b := v[i+1];
      if s gt 0 then
         v[i] := a*b*a^-1;
         v[i+1] := a;
      else
         v[i] := b;
         v[i+1] := b^-1*a*b;
      end if;
   end for;
   return v;
end function;



/* ***************************************
SignatureBraidWords(m)

Input:  m  the branching orders [m_1, ..., m_r]

Output: braid words generating the subgroup of the braid group B_r that
        maps a vector with orders m to a vector with orders m:
          sigma_i  when m_i = m_{i+1}, and
          A_ij = sigma_{j-1}^-1 ... sigma_{i+1}^-1 sigma_i^2 sigma_{i+1} ... sigma_{j-1}
               when i < j are in different blocks of equal orders.
        The A_ij generate the pure braid group, and the sigma_i generate
        the permutations of each block.
************************************ */

SignatureBraidWords := function(m)
   r := #m;
   words := [ [i] : i in [1..r-1] | m[i] eq m[i+1] ];
   for i in [1..r-1] do
      for j in [i+1..r] do
         if #{ m[k] : k in [i..j] } gt 1 then
            Append(~words, [ -k : k in [j-1..i+1 by -1] ] cat [i, i] cat [ k : k in [i+1..j-1] ]);
         end if;
      end for;
   end for;
   return words;
end function;



/* ***************************************
Lookup of generating vectors up to simultaneous conjugation.

Nothing here lists the elements of G or of a conjugacy class, so it works
for large permutation groups.

  NormalizeVector  conjugates v so that v[1] is the fixed representative of
                   its conjugacy class (from ConjugacyClasses(G))
  Invariant        classes of the entries and, for r > 3, of the products
                   v[i]*v[j]; these do not change under simultaneous conjugation
  IsSameClass      decides whether two normalized vectors with the same
                   invariant are simultaneously conjugate: conjugate v[2] to
                   w[2] inside H = C(w[1]), then v[3] to w[3] inside
                   H meet C(w[2]), and so on.  The last entry needs no test
                   since the product of the entries is 1.
  LookupVector     finds a vector in a table B (an associative array from
                   invariants to sequences of < vector, label >), optionally
                   inserting it

S holds the class map, the class representatives and a cache of the
centralizers used by IsSameClass.
************************************ */

LookupFormat := recformat< G, cm, reps, zsize, cent >;

NewLookupState := function(G)
   return rec< LookupFormat | G := G, cm := ClassMap(G),
                              reps := [ c[3] : c in ConjugacyClasses(G) ],
                              zsize := #Center(G),
                              cent := AssociativeArray(PowerSequence(G)) >;
end function;


NormalizeVector := procedure(~v, ~S)
   x := S`reps[S`cm(v[1])];
   _, g := IsConjugate(S`G, v[1], x);
   v := [ y^g : y in v ];
   if not IsDefined(S`cent, [x]) then
      S`cent[[x]] := Centralizer(S`G, x);
   end if;
end procedure;


Invariant := function(v, cm)
   r := #v;
   inv := [ cm(x) : x in v ];
   if r gt 3 then
      inv cat:= &cat[ [ cm(v[i]*v[j]) : j in [i+1..r] ] : i in [1..r-1] ];
   end if;
   return inv;
end function;


IsSameClass := procedure(v, w, ~S, ~res)
   r := #v;
   key := [ w[1] ];
   H := S`cent[key];
   for i in [2..r-1] do
      if #H eq S`zsize then
         res := v[i..r] eq w[i..r];
         return;
      end if;
      b, h := IsConjugate(H, v[i], w[i]);
      if not b then
         res := false;
         return;
      end if;
      if i lt r-1 then
         v := [ y^h : y in v ];
         Append(~key, w[i]);
         if not IsDefined(S`cent, key) then
            S`cent[key] := Centralizer(H, w[i]);
         end if;
         H := S`cent[key];
      end if;
   end for;
   res := true;
end procedure;


// found is the label of v in B, or 0 if v is not there; with insert := lab,
// a vector not found is added to B with label lab
LookupVector := procedure(v, ~B, ~S, ~found : insert := 0)
   found := 0;
   inv := Invariant(v, S`cm);
   if IsDefined(B, inv) then
      for e in B[inv] do
         IsSameClass(v, e[1], ~S, ~res);
         if res then
            found := e[2];
            return;
         end if;
      end for;
      if insert ne 0 then
         Append(~B[inv], < v, insert >);
      end if;
   elif insert ne 0 then
      B[inv] := [ < v, insert > ];
   end if;
end procedure;



/* ***************************************
FindOrbits(data)

Input:  data  the output of RepresentativesEpimorphisms(signature, G) for a
              signature [0, m_1, ..., m_r] with m_1 <= ... <= m_r: a sequence
              of records with fields signature, Con, Gro, genimages.

Optional:
        Topological  set to false to compute only the braid classes; the
                     second return value is then a copy of the first
        Check        set to false to skip the consistency checks on the data

Output: brd, top  sequences with brd[k] (resp. top[k]) the smallest index of
                  a vector in the braid (resp. topological) class of data[k]
************************************ */

FindOrbits := function(data : Topological := true, Check := true)

n := #data;
error if n eq 0, "FindOrbits: no generating vectors";
G := data[1]`Gro;
sig := data[1]`signature;
error if sig[1] ne 0, "FindOrbits: only quotient genus 0 is supported";
error if exists{ d : d in data | d`signature ne sig or d`Gro cmpne G },
      "FindOrbits: all records must have the same group and signature";
m := sig[2..#sig];
error if m ne Sort(m), "FindOrbits: the orders in the signature must be nondecreasing";

if n eq 1 then
   return [1], [1];
end if;

r := #m;
cm := ClassMap(G);

// blocks of positions with equal branching order
blocks := [];
for i in [1..r] do
   if i gt 1 and m[i] eq m[i-1] then
      Append(~blocks[#blocks], i);
   else
      Append(~blocks, [i]);
   end if;
end for;

// The multiset of classes in each block is a braid invariant
ClassTuple := func< v | [ cm(x) : x in v ] >;
MultisetKey := function(v)
   c := ClassTuple(v);
   return &cat[ Sort([ c[i] : i in B ]) : B in blocks ];
end function;

msData := AssociativeArray(PowerSequence(Integers()));     // multiset key -> indices of data with that multiset
msTuples := AssociativeArray(PowerSequence(Integers()));   // multiset key -> class tuples occurring in data
msOf := [];
for k in [1..n] do
   ms := MultisetKey(data[k]`genimages);
   Append(~msOf, ms);
   if IsDefined(msData, ms) then
      Append(~msData[ms], k);
      Include(~msTuples[ms], ClassTuple(data[k]`genimages));
   else
      msData[ms] := [k];
      msTuples[ms] := { ClassTuple(data[k]`genimages) };
   end if;
end for;

S := NewLookupState(G);
words := SignatureBraidWords(m);

// table of the vectors sharing their class multiset with another
dataTable := AssociativeArray(PowerSequence(Integers()));
nd := [ d`genimages : d in data ];
for k in [1..n] do
   if #msData[msOf[k]] gt 1 then
      v := nd[k];
      NormalizeVector(~v, ~S);
      nd[k] := v;
      LookupVector(v, ~dataTable, ~S, ~j : insert := k);
      if Check and j ne 0 then
         printf "WARNING: vectors %o and %o are simultaneously conjugate\n", j, k;
      end if;
   end if;
end for;


/* Braid classes.  Vectors whose class multiset is shared by no other vector
   are alone in their braid class.  Otherwise breadth-first search the braid
   orbit through all conjugacy classes of generating vectors with the right
   orders.  orbitTable labels each vector seen with the index of the first
   data vector of its orbit, which is the smallest. */

brd := [1..n];
warned := false;
orbitTable := AssociativeArray(PowerSequence(Integers()));
for k in [1..n] do
   if #msData[msOf[k]] eq 1 then
      continue;
   end if;
   LookupVector(nd[k], ~orbitTable, ~S, ~j : insert := k);
   if j ne 0 then
      brd[k] := j;
      continue;
   end if;

   queue := [ nd[k] ];
   pos := 1;
   while pos le #queue do
      v := queue[pos];
      pos +:= 1;
      for w in words do
         u := ApplyBraidWord(v, w);
         NormalizeVector(~u, ~S);
         LookupVector(u, ~orbitTable, ~S, ~j : insert := k);
         if j eq 0 then
            Append(~queue, u);
            if Check and not warned and ClassTuple(u) in msTuples[msOf[k]] then
               LookupVector(u, ~dataTable, ~S, ~d);
               if d eq 0 then
                  print "WARNING: data is incomplete; found a vector not in the list";
                  warned := true;
               end if;
            end if;
         end if;
      end for;
   end while;
end for;

if not Topological then
   return brd, brd;
end if;


/* Topological classes.  Aut(G) commutes with the braid action, so it permutes
   braid classes; union the classes along the outer automorphism generators. */

A := AutomorphismGroup(G);
outer := [ A.i : i in [1..Ngens(A)] | not IsInner(A.i) ];

parent := [1..n];
Find := function(parent, x)
   while parent[x] ne x do
      x := parent[x];
   end while;
   return x;
end function;

for k in [ k : k in [1..n] | brd[k] eq k ] do
   for alpha in outer do
      // braid class of the image of data[k] under alpha
      u := [ alpha(x) : x in data[k]`genimages ];
      ms := MultisetKey(u);
      error if not IsDefined(msData, ms), "FindOrbits: data is incomplete (missing class structure)";
      if #msData[ms] eq 1 then
         j := msData[ms][1];
      else
         NormalizeVector(~u, ~S);
         LookupVector(u, ~orbitTable, ~S, ~j);
         error if j eq 0, "FindOrbits: data is incomplete (missing vector)";
      end if;

      a := Find(parent, k);
      b := Find(parent, j);
      if a ne b then
         parent[Max(a,b)] := Min(a,b);
      end if;
   end for;
end for;

top := [ Find(parent, brd[k]) : k in [1..n] ];
return brd, top;

end function;



/* ***************************************
OrbitsFromIds(ids)

Input:  ids  a sequence as returned by FindOrbits

Output: the classes as a sequence of sequences of indices
************************************ */

OrbitsFromIds := function(ids)
   return [ [ k : k in [1..#ids] | ids[k] eq i ] : i in Sort(SetToSequence(Set(ids))) ];
end function;



/* ***************************************
PrintOrbits(data, brd, top)

Prints, for each generating vector, its class structure and the ids of its
braid and topological classes.  With file := "name" the output is appended
to that file instead; label is printed as a header line.
************************************ */

PrintOrbits := procedure(data, brd, top : file := "", label := "")
   lines := [];
   if label ne "" then
      Append(~lines, "# " cat label);
   end if;
   for k in [1..#data] do
      Append(~lines, Sprintf("%o: Con %o  braid %o  topological %o",
                             k, data[k]`Con, brd[k], top[k]));
   end for;
   for l in lines do
      if file eq "" then
         print l;
      else
         PrintFile(file, l);
      end if;
   end for;
end procedure;



/* ***************************************
ReadGenvectorFile(filename)

Reads a file written by AddMonodromy in genvectors.mag.  Each entry there is

   (order,number)
   signature
   class structure
   one line per permutation in the generating vector
   *

Consecutive entries with the same group and signature form one family.
The permutation group of a family is rebuilt as the group generated by its
vectors, so the class numbering may differ from the one in the file; the
Con field is recomputed.  Entries with no branching (signature [g0]) and
families with g0 > 0 are skipped.  Windows line endings and blank lines are
accepted.

Output: a sequence of families, each a sequence of records in the format of
        RepresentativesEpimorphisms, and a parallel sequence of labels
        "(order,number) signature"
************************************ */

ReadGenvectorFile := function(filename)

FP := Open(filename, "r");
entries := [* *];   // < groupstring, signature, list of permutations as sequences >
lines := [];
while true do
   l := Gets(FP);
   if IsEof(l) then
      break;
   end if;
   l := &cat([""] cat [ c : c in Eltseq(l) | c ne CodeToString(13) ]);   // drop CR
   if l eq "" then
      continue;
   end if;
   if l eq "*" then
      if #lines ge 4 then     // entries with no branching have no permutations
         Append(~entries, < lines[1], eval lines[2],
                            [ StringToIntegerSequence(p) : p in lines[4..#lines] ] >);
      end if;
      lines := [];
   else
      Append(~lines, l);
   end if;
end while;
delete FP;

families := [];
labels := [];
i := 1;
while i le #entries do
   j := i;
   while j lt #entries and entries[j+1][1] eq entries[i][1] and entries[j+1][2] eq entries[i][2] do
      j +:= 1;
   end while;
   sig := entries[i][2];
   if sig[1] eq 0 then
      deg := #entries[i][3][1];
      Sd := Sym(deg);
      vecs := [ [ Sd!p : p in entries[k][3] ] : k in [i..j] ];
      G := sub< Sd | &cat vecs >;
      cm := ClassMap(G);
      Append(~families, [ rec< ReFo | signature := sig, Gro := G,
                                      genimages := [ G!x : x in v ],
                                      Con := [ cm(x) : x in v ] > : v in vecs ]);
      Append(~labels, entries[i][1] cat " " cat Sprint(sig));
   end if;
   i := j + 1;
end while;

return families, labels;

end function;



/* ***************************************
OrbitsFromFile(infile, outfile)

Runs FindOrbits on every family in a file written by AddMonodromy and
appends the results to outfile with PrintOrbits.  A family that raises an
error gets an "ERROR" line in outfile and the remaining families still run.
************************************ */

OrbitsFromFile := procedure(infile, outfile)
   families, labels := ReadGenvectorFile(infile);
   for f in [1..#families] do
      try
         brd, top := FindOrbits(families[f]);
         PrintOrbits(families[f], brd, top : file := outfile, label := labels[f]);
      catch e
         PrintFile(outfile, "# " cat labels[f]);
         PrintFile(outfile, "ERROR: " cat e`Object);
      end try;
   end for;
end procedure;
